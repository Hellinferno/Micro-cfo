# MicroCFO MCP Server - Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to git!

# ============================================
# ENCRYPTION CONFIGURATION (NEW!)
# ============================================

# CRITICAL: Keep this key secure! Loss of this key means data cannot be decrypted
# Generate with: python setup_encryption.py
ENCRYPTION_KEY=your-encryption-key-here

# ============================================
# S3 STORAGE CONFIGURATION (NEW!)
# ============================================

# AWS Credentials (use IAM role in production)
# Note: These are also used for Textract OCR fallback
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# S3 Bucket for encrypted file storage
S3_BUCKET_NAME=microcfo-invoices

# Optional: Use SSE-KMS instead of SSE-S3 for more control
# KMS_KEY_ID=your-kms-key-id

# Local storage fallback (if S3 not configured)
LOCAL_STORAGE_DIR=file_storage

# ============================================
# AI API Keys (Multi-Provider LLM Support)
# ============================================

# Google Gemini API Key (PRIMARY - for Agent A Visual Auditor)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (FAST - ultra-low latency inference)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (FALLBACK - high quality reasoning)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API Key (alternative unified API)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Rate Limits
LLM_MAX_TOKENS=2000
LLM_RATE_LIMIT=60

# Optional: Google API Key (legacy)
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# OCR Provider Configuration (Agent A Fallbacks)
# ============================================

# Primary: Gemini (configured above)
# Fast and good quality, may struggle with handwritten text

# Fallback 1: AWS Textract (uses AWS credentials above)
# Fallback 2: Azure Form Recognizer (optional)
# Get credentials from: https://portal.azure.com/
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your_azure_form_recognizer_key

# OCR Confidence Threshold (0.0 - 1.0, default: 0.85)
# Invoices below this threshold will be flagged for human review
OCR_CONFIDENCE_THRESHOLD=0.85

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Database
DATABASE_URL=postgresql://microcfo:changeme@localhost:5432/microcfo
POSTGRES_DB=microcfo
POSTGRES_USER=microcfo
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ============================================
# Redis Configuration (for Async Task Queue)
# ============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis password (optional, recommended for production)
REDIS_PASSWORD=changeme

# Celery result backend (separate Redis DB)
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# Server Configuration
# ============================================

# Server host and port
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Frontend URL for CORS
FRONTEND_URL=http://localhost

# Backend and Frontend ports
BACKEND_PORT=8000
FRONTEND_PORT=80

# Flower monitoring dashboard port
FLOWER_PORT=5555

# ============================================
# Security Configuration
# ============================================

# JWT Secret Key (generate a strong random key for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Optional: WhatsApp Business API
# ============================================

# WhatsApp Provider: 'twilio' or 'meta'
WHATSAPP_PROVIDER=twilio

# Twilio Configuration (if WHATSAPP_PROVIDER=twilio)
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta Business API Configuration (if WHATSAPP_PROVIDER=meta)
# Sign up at: https://developers.facebook.com/docs/whatsapp/cloud-api/
META_WHATSAPP_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_BUSINESS_ID=your_business_id

# ============================================
# Vernacular Language Support (Hindi, Tamil, Telugu)
# ============================================

# Google Cloud Translation API (recommended)
# Get key from: https://cloud.google.com/translate/docs/setup
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# OR Azure Translator (alternative)
# Get key from: https://azure.microsoft.com/en-us/services/cognitive-services/translator/
AZURE_TRANSLATOR_KEY=your_azure_translator_key
AZURE_TRANSLATOR_REGION=eastus

# ============================================
# Account Aggregator (AA) Framework
# ============================================

# AA Provider: 'finvu', 'onemoney', 'cams', or 'sahamati_sandbox'
AA_PROVIDER=sahamati_sandbox

# FIU Credentials (get from your AA provider)
# Sahamati Sandbox: https://sahamati.org.in/
AA_CLIENT_ID=your_fiu_client_id
AA_CLIENT_SECRET=your_fiu_client_secret
AA_API_URL=https://api.sandbox.sahamati.org.in
AA_CALLBACK_URL=https://your-domain.com/api/v1/aa/callback

# ============================================
# Feature Flags
# ============================================

# Enable/disable AI agents
ENABLE_AGENT_A=true  # Visual Auditor
ENABLE_AGENT_B=true  # Legal Sentinel
ENABLE_AGENT_C=true  # Subsidy Hunter
ENABLE_AGENT_D=true  # Negotiator

# Enable/disable integrations
ENABLE_WHATSAPP=true
ENABLE_AA=false  # Account Aggregator requires FIU registration
ENABLE_ETL=true  # ETL scheduler for government data scraping

# ============================================
# Monitoring & Observability
# ============================================

# Sentry Error Tracking
# Sign up at: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here

# Datadog APM (optional)
# Sign up at: https://www.datadoghq.com/
DATADOG_API_KEY=your_datadog_api_key

# Enable metrics and tracing
ENABLE_METRICS=true
ENABLE_TRACING=true

# ============================================
# Email Service (SendGrid)
# ============================================

# SendGrid API Key (for Agent D emails)
# Sign up at: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@microcfo.com
EMAIL_FROM_NAME=MicroCFO

# ============================================
# Audit & Compliance
# ============================================

AUDIT_ENABLED=true
DISCLAIMER_ENABLED=true
