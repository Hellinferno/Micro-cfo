# MicroCFO Docker Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# CRITICAL: SECURITY KEYS (REQUIRED)
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# Generate with: python scripts/setup_encryption.py
ENCRYPTION_KEY=CHANGE_ME_TO_ENCRYPTION_KEY

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================

POSTGRES_DB=microcfo
POSTGRES_USER=microcfo
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_PORT=5432

# ============================================
# REDIS CONFIGURATION (REQUIRED)
# ============================================

REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ============================================
# AI API KEYS (REQUIRED)
# ============================================

# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter alternative
OPENROUTER_API_KEY=

# ============================================
# AWS CONFIGURATION (OPTIONAL)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ============================================
# AZURE CONFIGURATION (OPTIONAL)
# ============================================

AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=

# ============================================
# SERVER CONFIGURATION
# ============================================

DEBUG=false
FRONTEND_URL=http://localhost
BACKEND_PORT=8000
FRONTEND_PORT=80
FLOWER_PORT=5555

# ============================================
# JWT CONFIGURATION
# ============================================

JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
