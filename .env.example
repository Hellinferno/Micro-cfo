# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# Application Settings
# ============================================
APP_NAME=MicroCFO
APP_VERSION=2.0.0
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://microcfo:changeme@localhost:5432/microcfo
POSTGRES_USER=microcfo
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=microcfo

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AI/LLM API Keys
# ============================================
# Google Gemini API Key (get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# OpenRouter API Key (optional, for alternative models)
OPENROUTER_API_KEY=

# Groq API Key (optional, for fast inference)
GROQ_API_KEY=

# ============================================
# AWS Configuration (Optional)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=microcfo-storage

# ============================================
# Azure Configuration (Optional)
# ============================================
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=

# ============================================
# Telegram Bot (Optional, for notifications)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@microcfo.com

# ============================================
# Security Settings
# ============================================
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ============================================
# CORS Settings
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
